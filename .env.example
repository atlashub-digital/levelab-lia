NODE_ENV=production
PORT=8095

# Service-to-service endpoints
LEVELAB_BACKEND_BASE_URL=https://api.levelab.org/api/v1
ATENDIMENTO_BASE_URL=https://api.atendimento.center/api/v1

# Auth between internal services
# Inbound callers -> LIA
LIA_SERVICE_TOKEN=replace_me

# LIA -> LeveLab Backend
# Configure when the LeveLab context API is deployed.
LEVELAB_API_TOKEN=

# -------------------------------------------------------------------
# LLM routing
# -------------------------------------------------------------------
# Primary provider: OpenAI direct
# IMPORTANT: OPENAI_API_KEY must be an OpenAI Platform key, not an sk-or-* OpenRouter key.
LLM_PRIMARY_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Fallback / experimentation provider: OpenRouter
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=openrouter
# OpenRouter keys typically start with sk-or-...
OPENROUTER_API_KEY=

# Ordered model list tried one after another (errors, rate limits or
# non-conversational output move to the next). Never use the openrouter/free
# router: it can pick safety classifiers that answer "User Safety: safe".
# Free endpoints may log prompts — temporary use only for health conversations.
OPENROUTER_MODELS=qwen/qwen3.8-27b:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free
# Legacy single-model setting (used only when OPENROUTER_MODELS is empty)
OPENROUTER_MODEL=

# Optional higher-quality OpenAI model for more complex reasoning
OPENAI_REASONING_MODEL=gpt-5.6-terra

# -------------------------------------------------------------------
# Memory adapter
# -------------------------------------------------------------------
# "internal" means LIA memory is owned by our own data layer.
# No external memory URL or API key is required.
MEMORY_PROVIDER=internal
MEMORY_URL=
MEMORY_API_KEY=
